# Copie a .env.local (desarrollo) o configúrelas en Vercel → Settings → Environment Variables.
# Sin estas variables la app funciona en modo local (demo) con localStorage.

# Supabase → Project Settings → API (la clave "anon"/"publishable" es pública por diseño; la protege RLS)
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# Backend en Render (sin barra final). Habilita el motor "Servicio backend" y el relé de alertas.
VITE_API_URL=https://aurora-ix-api.onrender.com
